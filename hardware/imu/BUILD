load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@arm_none_eabi//:defs.bzl", "BIN_PREFIX")
load("//schema/tools:generate_messages.bzl", "generate_messages")


# ─── CMSIS Core ───────────────────────────────────────────────────────────────

cc_library(
    name = "cmsis_core",
    hdrs = glob(["st_hal/Drivers/CMSIS/Include/*.h"]),
    includes = ["st_hal/Drivers/CMSIS/Include"],
    visibility = ["//visibility:public"],
)

# ─── CMSIS Device (STM32G4xx) ─────────────────────────────────────────────────

cc_library(
    name = "cmsis_device",
    hdrs = glob(["st_hal/Drivers/CMSIS/Device/ST/STM32G4xx/Include/*.h"]),
    includes = ["st_hal/Drivers/CMSIS/Device/ST/STM32G4xx/Include"],
    copts = ["-DSTM32G431xx"],
    deps = [":cmsis_core"],
    visibility = ["//visibility:public"],
)

# ─── STM32G4 HAL Driver ───────────────────────────────────────────────────────

cc_library(
    name = "stm32g4_hal",
    srcs = glob(["st_hal/Drivers/STM32G4xx_HAL_Driver/Src/*.c"]),
    hdrs = glob([
        "st_hal/Drivers/STM32G4xx_HAL_Driver/Inc/*.h",
        "st_hal/Drivers/STM32G4xx_HAL_Driver/Inc/Legacy/*.h",
    ]),
    includes = [
        "st_hal/Drivers/STM32G4xx_HAL_Driver/Inc",
        "st_hal/Drivers/STM32G4xx_HAL_Driver/Inc/Legacy",
    ],
    copts = [
        "-DSTM32G431xx",
        "-DUSE_HAL_DRIVER",
    ],
    deps = [
        ":cmsis_device",
        ":hal_conf",
    ],
    visibility = ["//visibility:public"],
)

# ─── HAL Config (generated by CubeMX) ─────────────────────────────────────────

cc_library(
    name = "hal_conf",
    hdrs = ["st_hal/Core/Inc/stm32g4xx_hal_conf.h"],
    includes = ["st_hal/Core/Inc"],
    deps = [":cmsis_device"],
    visibility = ["//visibility:public"],
)


cc_library(
    name = "usb_conf",
    hdrs = ["st_hal/USB_Device/Target/usbd_conf.h"],
    includes = ["st_hal/USB_Device/Target"],
    deps = [":stm32g4_hal"],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "core",
    srcs = glob(
        ["st_hal/Core/Src/*.c"],
        exclude = ["st_hal/Core/Src/main.c"],
    ),
    hdrs = glob(["st_hal/Core/Inc/*.h"]),
    includes = ["st_hal/Core/Inc"],
    copts = ["-DSTM32G431xx", "-DUSE_HAL_DRIVER"],
    deps = [":stm32g4_hal", ":usb_device"],
    alwayslink = True,   # contains stm32g4xx_hal_msp.c weak-symbol overrides
    visibility = ["//visibility:public"],
)

cc_library(
    name = "usb_device",
    srcs = glob(["st_hal/USB_Device/App/*.c", "st_hal/USB_Device/Target/*.c"]),
    hdrs = glob(["st_hal/USB_Device/App/*.h", "st_hal/USB_Device/Target/*.h"]),
    includes = ["st_hal/USB_Device/App", "st_hal/USB_Device/Target"],
    copts = ["-DSTM32G431xx", "-DUSE_HAL_DRIVER"],
    deps = [":stm32g4_hal", ":usb_middleware"],
    alwayslink = True,   # cyclic w/ usb_middleware (usbd_conf.c <-> usbd_core.c)
    visibility = ["//visibility:public"],
)

cc_library(
    name = "usb_middleware",
    srcs = glob([
        "st_hal/Middlewares/ST/STM32_USB_Device_Library/Core/Src/*.c",
        "st_hal/Middlewares/ST/STM32_USB_Device_Library/Class/CDC/Src/*.c",
    ],
    exclude = ["st_hal/Middlewares/ST/STM32_USB_Device_Library/Core/Src/*_template.c"],),
    hdrs = glob([
        "st_hal/Middlewares/ST/STM32_USB_Device_Library/Core/Inc/*.h",
        "st_hal/Middlewares/ST/STM32_USB_Device_Library/Class/CDC/Inc/*.h",
    ]),
    includes = [
        "st_hal/Middlewares/ST/STM32_USB_Device_Library/Core/Inc",
        "st_hal/Middlewares/ST/STM32_USB_Device_Library/Class/CDC/Inc",
    ],
    copts = ["-DSTM32G431xx", "-DUSE_HAL_DRIVER"],
    deps = [":stm32g4_hal", ":usb_conf"],
    alwayslink = True,   # cyclic w/ usb_device (usbd_core.c <-> usbd_conf.c)
    visibility = ["//visibility:public"],
)

generate_messages(
    name = "imu_messages",
    schema = "schema/messages.toml",
    visibility = ["//visibility:public"],
)

cc_library(
    name = "scheduler",
    srcs = ["//common/scheduler:scheduler_srcs"],
    hdrs = ["//common/scheduler:scheduler_hdrs"],
    copts = ["-DSTM32G431xx", "-DUSE_HAL_DRIVER"],
    strip_include_prefix = "",
    deps = [
        ":core",
    ],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "memory",
    srcs = ["//common/memory:memory_srcs"],
    hdrs = ["//common/memory:memory_hdrs"],
    copts = ["-DSTM32G431xx", "-DUSE_HAL_DRIVER"],
    strip_include_prefix = "",
    deps = [
        ":core",
    ],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "app",
    srcs = glob(["app/src/*.cpp"]),
    hdrs = glob(["app/inc/*.h"]),
    includes = ["app/inc"],
    copts = [
        "-DSTM32G431xx",
        "-DUSE_HAL_DRIVER",
        "-std=c++17",
        "-fno-rtti",
    ],
    deps = [
        ":stm32g4_hal",
        ":hal_conf",
        ":usb_device",
        ":core",
        ":memory",
        "//common:ipc",
        ":scheduler",
        "//common:transform",
        "//common:bmi270",
        "//common:bmm150",
        ":imu_messages_cpp",
        "//schema:common_messages_cpp"
    ],
    visibility = ["//visibility:public"],
)

# ─── Firmware Binary ──────────────────────────────────────────────────────────

cc_binary(
    name = "firmware",
    srcs = [
        "st_hal/Core/Src/main.c",
        "st_hal/startup_stm32g431xx.s",
    ],
    copts = [
        "-DSTM32G431xx",
        "-DUSE_HAL_DRIVER",
    ],
    linkopts = [
        "-T$(location st_hal/STM32G431XX_FLASH.ld)",
        "-Wl,-Map=firmware.map",
        "-Wl,-u,_printf_float",
    ],
    additional_linker_inputs = ["st_hal/STM32G431XX_FLASH.ld"],
    deps = [
        ":core",
        ":app",
    ],
)

# ─── Post-build outputs ───────────────────────────────────────────────────────
genrule(
    name = "firmware_bin",
    srcs = [":firmware"],
    outs = ["firmware.bin"],
    cmd = "$(OBJCOPY) -O binary $< $@",
    toolchains = ["@bazel_tools//tools/cpp:current_cc_toolchain"],
)

genrule(
    name = "firmware_hex",
    srcs = [":firmware"],
    outs = ["firmware.hex"],
    cmd = """
    %s-size $(SRCS)
    $(OBJCOPY) -O ihex $< $@
    """ % BIN_PREFIX,
    toolchains = ["@bazel_tools//tools/cpp:current_cc_toolchain"],
)

sh_binary(
    name = "flash",
    srcs = ["flash.sh"],
    data = [":firmware_hex"],
    args = ["$(location :firmware_hex)"],
)